#!/bin/zsh
set -euo pipefail

APP_DIR="${0:A:h:h:h}"
PROJECT_ROOT=""

for candidate in "${APP_DIR:h}" "${JOYCONDEX_ROOT:-}" "$HOME/codex-work/JoyCondex-controller" "$HOME/codex-work/Codex_controller"; do
  if [[ -n "$candidate" && -x "$candidate/START_JOYCON_LIVE.command" ]]; then
    PROJECT_ROOT="$candidate"
    break
  fi
done

if [[ -z "$PROJECT_ROOT" ]]; then
  osascript -e 'display alert "JoyCondexを起動できません" message "joycondex-controllerフォルダが見つかりません。" as critical'
  exit 1
fi

if curl -fsS --max-time 1 http://127.0.0.1:8788/health >/dev/null 2>&1; then
  open -a "Google Chrome" http://127.0.0.1:8788/
  exit 0
fi

osascript \
  -e 'tell application "Terminal"' \
  -e "do script \"$PROJECT_ROOT/START_JOYCON_LIVE.command\"" \
  -e 'activate' \
  -e 'end tell'
